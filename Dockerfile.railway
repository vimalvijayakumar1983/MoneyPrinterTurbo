FROM ghcr.io/harry0703/moneyprinterturbo:latest

# Reuse the upstream video dependencies and FFmpeg, then add a login proxy.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx apache2-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /MoneyPrinterTurbo
COPY . .
COPY deploy/nginx.conf /etc/nginx/nginx.conf

ENV MPT_CONFIG_FILE=/data/config.toml
EXPOSE 8080
CMD ["sh", "deploy/railway-start.sh"]
